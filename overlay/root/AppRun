#!/bin/sh
CURRENTDIR="$(dirname "$(readlink -f "$0")")"
export PATH="${CURRENTDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${CURRENTDIR}/usr/bin:${CURRENTDIR}/usr/lib:${LD_LIBRARY_PATH}"
export MOZ_LEGACY_PROFILES=1          # Prevent per installation profiles
export MOZ_ALLOW_DOWNGRADE=1          # Prevent older version profile protection dialog
export MOZ_APP_LAUNCHER="${APPIMAGE}" # Allows setting as default browser
export MOZ_APP_NAME="deckywolf"
export MOZ_APP_REMOTINGNAME="deckywolf"
export MOZ_APP_DISPLAYNAME="DeckyWolf"

# Steam Deck Game Mode & Wayland Sharpness Fix:
# Enable native Wayland rendering when running under Wayland or Gamescope session.
# This eliminates blurriness/soapy scaling caused by XWayland in Game Mode.
if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] || [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    export MOZ_ENABLE_WAYLAND=1
fi

# Register DeckyWolf desktop entry and icons for window manager / taskbar icon resolution
if [ -f "${CURRENTDIR}/net.deckywolf.DeckyWolf.desktop" ]; then
    mkdir -p "${HOME}/.local/share/applications"
    if [ -n "${APPIMAGE}" ]; then
        sed "s|^Exec=.*|Exec=\"${APPIMAGE}\" %u|" "${CURRENTDIR}/net.deckywolf.DeckyWolf.desktop" > "${HOME}/.local/share/applications/deckywolf.desktop"
    else
        sed "s|^Exec=.*|Exec=\"${CURRENTDIR}/AppRun\" %u|" "${CURRENTDIR}/net.deckywolf.DeckyWolf.desktop" > "${HOME}/.local/share/applications/deckywolf.desktop"
    fi
    # Remove old duplicate desktop entry if present
    rm -f "${HOME}/.local/share/applications/net.deckywolf.DeckyWolf.desktop" 2>/dev/null || true
fi
if [ -d "${CURRENTDIR}/usr/share/icons/hicolor" ]; then
    mkdir -p "${HOME}/.local/share/icons/hicolor"
    cp -rn "${CURRENTDIR}/usr/share/icons/hicolor"/* "${HOME}/.local/share/icons/hicolor/" 2>/dev/null || true
fi
if [ -f "${CURRENTDIR}/deckywolf.png" ]; then
    mkdir -p "${HOME}/.local/share/icons/hicolor/128x128/apps"
    cp -f "${CURRENTDIR}/deckywolf.png" "${HOME}/.local/share/icons/hicolor/128x128/apps/deckywolf.png"
    mkdir -p "${HOME}/.local/share/icons"
    cp -f "${CURRENTDIR}/deckywolf.png" "${HOME}/.local/share/icons/deckywolf.png"
fi

# Install DeckyWolf WebApp Manager and Native Messaging host
mkdir -p "${HOME}/.local/bin"
if [ -x "${CURRENTDIR}/usr/bin/deckywolf-webapp-manager" ]; then
    cp -f "${CURRENTDIR}/usr/bin/deckywolf-webapp-manager" "${HOME}/.local/bin/deckywolf-webapp-manager"
    chmod +x "${HOME}/.local/bin/deckywolf-webapp-manager"
fi

# Register Native Messaging host manifest for LibreWolf & Firefox
NATIVE_HOSTS_JSON="{\"name\":\"deckywolf_webapps\",\"description\":\"DeckyWolf WebApp Manager Host\",\"path\":\"${HOME}/.local/bin/deckywolf-webapp-manager\",\"type\":\"stdio\",\"allowed_extensions\":[\"webapps@deckywolf.net\"]}"
for hdir in "${HOME}/.librewolf/native-messaging-hosts" "${HOME}/.mozilla/native-messaging-hosts"; do
    mkdir -p "$hdir"
    echo "$NATIVE_HOSTS_JSON" > "$hdir/deckywolf_webapps.json" 2>/dev/null || true
done

# Ensure unsigned extensions are allowed for DeckyWolf WebApps
for p in "${HOME}/.config/librewolf/librewolf"/*/; do
    if [ -d "$p" ] && [ -f "$p/prefs.js" ]; then
        if ! grep -q "xpinstall.signatures.required" "$p/prefs.js" 2>/dev/null; then
            echo 'user_pref("xpinstall.signatures.required", false);' >> "$p/prefs.js"
        fi
    fi
done

# Start background controller daemon
if [ -x "${CURRENTDIR}/usr/bin/deckywolf-controller" ]; then
    "${CURRENTDIR}/usr/bin/deckywolf-controller" &
    CONTROLLER_PID=$!
fi

# Start background TorrentWolf service on port 8404
if [ -x "${CURRENTDIR}/usr/bin/deckywolf-torrent-service" ]; then
    "${CURRENTDIR}/usr/bin/deckywolf-torrent-service" &
    TORRENT_PID=$!
fi

cleanup() {
    if [ -n "${CONTROLLER_PID}" ]; then
        kill "${CONTROLLER_PID}" 2>/dev/null
    fi
    if [ -n "${TORRENT_PID}" ]; then
        kill "${TORRENT_PID}" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

# Ensure LD_PRELOAD path has no spaces (AppImage path might contain spaces)
if [ -f "${CURRENTDIR}/usr/lib/deckywolf-hook.so" ]; then
    cp -f "${CURRENTDIR}/usr/lib/deckywolf-hook.so" /tmp/deckywolf-hook.so 2>/dev/null
    if [ -n "${LD_PRELOAD}" ]; then
        export LD_PRELOAD="/tmp/deckywolf-hook.so:${LD_PRELOAD}"
    else
        export LD_PRELOAD="/tmp/deckywolf-hook.so"
    fi
fi

"${CURRENTDIR}/usr/bin/deckywolf" --name deckywolf --class deckywolf --allow-downgrade "$@"
EXIT_CODE=$?

cleanup 2>/dev/null
exit ${EXIT_CODE}
