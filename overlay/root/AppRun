#!/bin/bash
CURRENTDIR="$(dirname "$(readlink -f "$0")")"
export PATH="${CURRENTDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${CURRENTDIR}/usr/bin:${CURRENTDIR}/usr/lib:${LD_LIBRARY_PATH}"
export MOZ_LEGACY_PROFILES=1          # Prevent per installation profiles
export MOZ_ALLOW_DOWNGRADE=1          # Prevent older version profile protection dialog
export MOZ_APP_LAUNCHER="${APPIMAGE}" # Allows setting as default browser
export MOZ_APP_NAME="deckywolf"
export MOZ_APP_REMOTINGNAME="deckywolf"
export MOZ_APP_DISPLAYNAME="DeckyWolf"

# Steam Deck Game Mode & Wayland Handling:
# In Steam Game Mode (under Gamescope), Gamescope does not implement the full desktop
# Wayland shell extensions required by Firefox/Gecko, causing a crash on startup.
# We must use X11 with EGL hardware acceleration under Gamescope, and native Wayland in desktop mode (KDE Plasma).
if [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] || [ "$XDG_CURRENT_DESKTOP" = "gamescope" ]; then
    unset WAYLAND_DISPLAY
    unset MOZ_ENABLE_WAYLAND
    export GDK_BACKEND=x11
    export MOZ_X11_EGL=1
    export GTK_CSD=0
    export GTK_OVERLAY_SCROLLING=0
    export GTK_MODULES=""
    export GDK_DPI_SCALE=1.0
    export GDK_SCALE=1
elif [ -n "$WAYLAND_DISPLAY" ] || [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    export MOZ_ENABLE_WAYLAND=1
fi

# Register DeckyWolf desktop entry and icons for window manager / taskbar icon resolution
if [ -f "${CURRENTDIR}/net.deckywolf.DeckyWolf.desktop" ]; then
    mkdir -p "${HOME}/.local/share/applications"
    if [ -n "${APPIMAGE}" ]; then
        sed "s|^Exec=.*|Exec=\"${APPIMAGE}\" %u|" "${CURRENTDIR}/net.deckywolf.DeckyWolf.desktop" > "${HOME}/.local/share/applications/deckywolf.desktop"
    else
        sed "s|^Exec=.*|Exec=\"${CURRENTDIR}/AppRun\" %u|" "${CURRENTDIR}/net.deckywolf.DeckyWolf.desktop" > "${HOME}/.local/share/applications/deckywolf.desktop"
    fi
    # Remove old duplicate desktop entry if present
    rm -f "${HOME}/.local/share/applications/net.deckywolf.DeckyWolf.desktop" 2>/dev/null || true
fi
if [ -d "${CURRENTDIR}/usr/share/icons/hicolor" ]; then
    mkdir -p "${HOME}/.local/share/icons/hicolor"
    cp -rn "${CURRENTDIR}/usr/share/icons/hicolor"/* "${HOME}/.local/share/icons/hicolor/" 2>/dev/null || true
fi
if [ -f "${CURRENTDIR}/deckywolf.png" ]; then
    mkdir -p "${HOME}/.local/share/icons/hicolor/128x128/apps"
    cp -f "${CURRENTDIR}/deckywolf.png" "${HOME}/.local/share/icons/hicolor/128x128/apps/deckywolf.png"
    mkdir -p "${HOME}/.local/share/icons"
    cp -f "${CURRENTDIR}/deckywolf.png" "${HOME}/.local/share/icons/deckywolf.png"
fi

if [ -d "${CURRENTDIR}/usr/share/deckywolf" ]; then
    mkdir -p "${HOME}/.local/share/deckywolf"
    cp -rn "${CURRENTDIR}/usr/share/deckywolf"/* "${HOME}/.local/share/deckywolf/" 2>/dev/null || true
fi

# Install DeckyWolf WebApp Manager and Torrent Service
mkdir -p "${HOME}/.local/bin"
if [ -x "${CURRENTDIR}/usr/bin/deckywolf-webapp-manager" ]; then
    cp -f "${CURRENTDIR}/usr/bin/deckywolf-webapp-manager" "${HOME}/.local/bin/deckywolf-webapp-manager"
    chmod +x "${HOME}/.local/bin/deckywolf-webapp-manager"
fi
if [ -x "${CURRENTDIR}/usr/bin/deckywolf-torrent-service" ]; then
    cp -f "${CURRENTDIR}/usr/bin/deckywolf-torrent-service" "${HOME}/.local/bin/deckywolf-torrent-service"
    chmod +x "${HOME}/.local/bin/deckywolf-torrent-service"
fi

# Register Native Messaging host manifest for LibreWolf & Firefox
NATIVE_HOSTS_JSON="{\"name\":\"deckywolf_webapps\",\"description\":\"DeckyWolf WebApp Manager Host\",\"path\":\"${HOME}/.local/bin/deckywolf-webapp-manager\",\"type\":\"stdio\",\"allowed_extensions\":[\"webapps@deckywolf.net\"]}"
for hdir in "${HOME}/.librewolf/native-messaging-hosts" "${HOME}/.mozilla/native-messaging-hosts" "${HOME}/.deckywolf/native-messaging-hosts"; do
    mkdir -p "$hdir"
    echo "$NATIVE_HOSTS_JSON" > "$hdir/deckywolf_webapps.json" 2>/dev/null || true
done

# Ensure unsigned extensions are allowed for DeckyWolf WebApps
for p in "${HOME}/.config/librewolf/librewolf"/*/; do
    if [ -d "$p" ] && [ -f "$p/prefs.js" ]; then
        if ! grep -q "xpinstall.signatures.required" "$p/prefs.js" 2>/dev/null; then
            echo 'user_pref("xpinstall.signatures.required", false);' >> "$p/prefs.js"
        fi
    fi
done

# Clean stale lock files from abrupt shutdowns
for p in "${HOME}/.config/librewolf/librewolf"/*/; do
    if [ -d "$p" ]; then
        rm -f "$p/lock" "$p/.parentlock" 2>/dev/null || true
    fi
done

# Register DeckyWolf systemd user service for TorrentWolf & WebApp Bridge
if command -v systemctl >/dev/null 2>&1; then
    mkdir -p "${HOME}/.config/systemd/user"
    cat << 'EOF' > "${HOME}/.config/systemd/user/deckywolf-torrent.service"
[Unit]
Description=DeckyWolf Torrent & WebApp Bridge Service
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/deckywolf-torrent-service
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now deckywolf-torrent.service 2>/dev/null || true
fi

# Start background controller daemon
if [ -x "${CURRENTDIR}/usr/bin/deckywolf-controller" ]; then
    "${CURRENTDIR}/usr/bin/deckywolf-controller" &
    CONTROLLER_PID=$!
fi

# Start background TorrentWolf service on port 8404 asynchronously if not already running
if ! python3 -c "import socket; s = socket.socket(); s.connect(('127.0.0.1', 8404)); s.close()" 2>/dev/null; then
    if [ -x "${HOME}/.local/bin/deckywolf-torrent-service" ]; then
        "${HOME}/.local/bin/deckywolf-torrent-service" &
    elif [ -x "${CURRENTDIR}/usr/bin/deckywolf-torrent-service" ]; then
        "${CURRENTDIR}/usr/bin/deckywolf-torrent-service" &
    fi
fi

cleanup() {
    if [ -n "${CONTROLLER_PID}" ]; then
        kill "${CONTROLLER_PID}" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

# Ensure LD_PRELOAD path has no spaces (AppImage path might contain spaces)
if [ -f "${CURRENTDIR}/usr/lib/deckywolf-hook.so" ]; then
    cp -f "${CURRENTDIR}/usr/lib/deckywolf-hook.so" /tmp/deckywolf-hook.so 2>/dev/null
    if [ -n "${LD_PRELOAD}" ]; then
        export LD_PRELOAD="/tmp/deckywolf-hook.so:${LD_PRELOAD}"
    else
        export LD_PRELOAD="/tmp/deckywolf-hook.so"
    fi
fi

# Detect display or gamescope resolution dynamically (universal for Steam Deck 800p, Ally 1080p, TV 4K)
EXTRA_ARGS=()
if [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] || [ "$XDG_CURRENT_DESKTOP" = "gamescope" ]; then
    DETECTED_RES=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2}')
    if [ -n "$DETECTED_RES" ]; then
        RES_W="${DETECTED_RES%x*}"
        RES_H="${DETECTED_RES#*x}"
    else
        RES_W="${GAMESCOPE_WIDTH:-${STEAM_GAME_WIDTH:-1280}}"
        RES_H="${GAMESCOPE_HEIGHT:-${STEAM_GAME_HEIGHT:-800}}"
    fi
    EXTRA_ARGS=(-width "$RES_W" -height "$RES_H")

    # In Game Mode, ensure saved window size perfectly matches display canvas and profile is pre-initialized
    python3 -c "
import glob, json, os
prof_dir = os.path.expanduser('~/.config/librewolf/librewolf')
profiles = [p for p in glob.glob(os.path.join(prof_dir, '*')) if os.path.isdir(p)]
if not profiles:
    # First-run: pre-create default profile so Gecko never hangs or triggers first-run wizard in Game Mode
    def_p = os.path.join(prof_dir, 'default.default-release')
    os.makedirs(def_p, exist_ok=True)
    ini_path = os.path.join(prof_dir, 'profiles.ini')
    if not os.path.isfile(ini_path):
        try:
            with open(ini_path, 'w') as f:
                f.write('[Profile0]\nName=default\nIsRelative=1\nPath=default.default-release\nDefault=1\n\n[General]\nStartWithLastProfile=1\nVersion=2\n')
        except Exception:
            pass
    profiles = [def_p]

for p in profiles:
    if not os.path.isdir(p):
        continue
    pjs = os.path.join(p, 'prefs.js')
    if not os.path.isfile(pjs):
        try:
            with open(pjs, 'w') as f:
                f.write('user_pref(\"browser.migration.version\", 999);\nuser_pref(\"xpinstall.signatures.required\", false);\n')
        except Exception:
            pass
    xs = os.path.join(p, 'xulstore.json')
    d = {}
    if os.path.isfile(xs):
        try:
            with open(xs, 'r') as f:
                d = json.load(f)
        except Exception:
            d = {}
    mw = d.setdefault('chrome://browser/content/browser.xhtml', {}).setdefault('main-window', {})
    mw['sizemode'] = 'normal'
    mw['width'] = '${RES_W}'
    mw['height'] = '${RES_H}'
    mw['screenX'] = '0'
    mw['screenY'] = '0'
    try:
        with open(xs, 'w') as f:
            json.dump(d, f)
    except Exception:
        pass
" 2>/dev/null || true
elif [ -n "$STEAM_GAME_WIDTH" ] && [ -n "$STEAM_GAME_HEIGHT" ]; then
    EXTRA_ARGS=(-width "$STEAM_GAME_WIDTH" -height "$STEAM_GAME_HEIGHT")
fi

"${CURRENTDIR}/usr/bin/deckywolf" --name deckywolf --class deckywolf --allow-downgrade "${EXTRA_ARGS[@]}" "$@"
EXIT_CODE=$?

cleanup 2>/dev/null
exit ${EXIT_CODE}
