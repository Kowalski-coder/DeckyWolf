xpinstall-prompt = Harzet eo bet gant { -brand-short-name } da leuskel al lec'hienn-mañ da staliañ meziantoù war hoc'h urzhiataer.
xpinstall-prompt-header = Aotren { $host } da staliañ un enlugellad?
