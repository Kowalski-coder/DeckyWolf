webrtc-share-monitor = Sgrìn { $monitorIndex }
webrtc-share-application =
    { $windowCount ->
        [one] { $appName } ({ $windowCount } uinneag)
        [two] { $appName } ({ $windowCount } uinneag)
        [few] { $appName } ({ $windowCount } uinneagan)
       *[other] { $appName } ({ $windowCount } uinneag)
    }
