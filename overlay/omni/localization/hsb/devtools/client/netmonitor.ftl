    .title = Wulkosć/přenjesena wulkosć wšěch naprašowanjow
network-menu-summary-finish = Kónc: { $formattedTime }
network-menu-summary-tooltip-finish =
    .title = Trěbny cyłkowny čas za začitanje naprašowanjow
