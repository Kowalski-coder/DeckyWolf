account-reconnect = পুনঃসংযোগ { $email }
account-verify = { $email } যাচাইকরণ
account-send-to-all-devices-titlecase = সকল ডিভাইসে পাঠাও
account-manage-devices-titlecase = ডিভাইসগুলি পরিচালনা করুন...
