network-menu-summary-tooltip-perf =
    .title = Pradėti našumo analizę
network-menu-summary-tooltip-domcontentloaded =
    .title = Laikas, kai įvyko „DOMContentLoaded“ įvykis
network-menu-summary-tooltip-load =
    .title = Laikas, kai įvyko „load“ įvykis
network-menu-summary-requests-count =
    { $requestCount ->
        [0] Užklausų nėra
        [one] { $requestCount } užklausa
        [few] { $requestCount } užklausos
       *[other] { $requestCount } užklausų
    }
network-menu-summary-tooltip-requests-count =
    .title = Užklausų skaičius
network-menu-summary-transferred = { $formattedContentSize } / { $formattedTransferredSize } perduota
network-menu-summary-tooltip-transferred =
    .title = Visų užklausų dydis / perduotas dydis
network-menu-summary-finish = Pabaiga: { $formattedTime }
network-menu-summary-tooltip-finish =
    .title = Bendras laikas, užtruktas vykdant visas užklausas
