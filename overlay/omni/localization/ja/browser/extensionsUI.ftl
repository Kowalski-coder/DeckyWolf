webext-default-search-description = { $addonName } が既定の検索エンジンを { $currentEngine } から { $newEngine } へ変更しようとしています。よろしいですか？
webext-default-search-yes =
    .label = はい
    .accesskey = Y
webext-default-search-no =
    .label = いいえ
    .accesskey = N
addon-post-install-message = { $addonName } が追加されました。
