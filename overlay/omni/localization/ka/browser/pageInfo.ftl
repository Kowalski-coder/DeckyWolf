            [one] მონაცემები (1 ჭდე)
           *[other] მონაცემები ({ $tags } ჭდე)
        }
security-visits-number =
    { $visits ->
        [0] არა
        [one] დიახ, ერთხელ
       *[other] დიახ, { $visits }-ჯერ
    }
properties-general-size =
    .value =
        { $bytes ->
            [one] { $kb } კბ ({ $bytes } ბაიტი)
           *[other] { $kb } კბ ({ $bytes } ბაიტი)
        }
