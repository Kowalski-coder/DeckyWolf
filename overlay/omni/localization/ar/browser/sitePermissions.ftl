site-permissions-open-blocked-popups =
    { $count ->
        [zero] لا تفتح أي نوافذ منبثقة محجوبة…
        [one] افتح نافذة منبثقة محجوبة…
        [two] افتح نافذتين منبثقتين محجوبتين…
        [few] افتح { $count } نوافذ منبثقة محجوبة…
        [many] افتح { $count } نافذة منبثقة محجوبة…
       *[other] افتح { $count } نافذة منبثقة محجوبة…
    }
site-permissions-unblock-redirect = إلغِ حظر إعادة التوجيه من جهات خارجية…
