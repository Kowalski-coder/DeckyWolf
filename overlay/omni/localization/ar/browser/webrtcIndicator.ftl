webrtc-indicator-menuitem-sharing-camera-with-n-tabs =
    .label =
        { $tabCount ->
            [zero] لا تشارك الكمرة مع أي ألسنة
            [one] تشارك الكمرة مع لسان واحد
            [two] تشارك الكمرة مع لسانين
