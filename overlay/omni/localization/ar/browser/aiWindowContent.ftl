smart-window-confirm-open-tab = افتح
smart-window-confirm-open-tabs =
    { $count ->
        [zero] افتح { $count } لسان
        [one] افتح لسان واحد
        [two] افتح لسانان
        [few] افتح { $count } ألسنة
        [many] افتح { $count } لسانًا
       *[other] افتح { $count } لسان
    }
