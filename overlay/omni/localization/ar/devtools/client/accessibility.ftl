accessibility-progress-progressbar =
    { $nodeCount ->
        [zero] لا يفحص أي عقدة
        [one] يفحص عقدة واحدة
        [two] يفحص عقدتين اثنتين
        [few] يفحص { $nodeCount } عقد
        [many] يفحص { $nodeCount } عقدة
       *[other] يفحص { $nodeCount } عقدة
    }
