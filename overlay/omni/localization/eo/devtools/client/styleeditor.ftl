    .label = Malfermi ligilon en nova langeto
styleeditor-copy-url =
    .label = Kopii retadreson
styleeditor-find =
    .label = Serĉi
    .accesskey = S
styleeditor-find-again =
    .label = Serĉi denove
    .accesskey = n
