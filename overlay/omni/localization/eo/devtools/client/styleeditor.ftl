    { $ruleCount ->
        [one] { $ruleCount } regulo.
       *[other] { $ruleCount } reguloj.
    }
styleeditor-pretty-print-button =
    .title = Aranĝi kaj deŝovi stilfolion
styleeditor-pretty-print-button-disabled =
    .title = Nur eblas aranĝi kaj deŝovi dosierojn CSS
styleeditor-pretty-print-button-disabled-read-only =
