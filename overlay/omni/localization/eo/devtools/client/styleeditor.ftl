styleeditor-new-button =
    .tooltiptext = Krei kaj aldoni novan stilfolion al la dokumento
    .accesskey = N
styleeditor-import-button =
    .tooltiptext = Importi kaj aldoni ekzistantan stilfolion al la dokumento
    .accesskey = I
styleeditor-filter-input =
    .placeholder = Filtri stilfoliojn
styleeditor-visibility-toggle =
    .tooltiptext = Ŝalti/malŝalti la videblon de stilfolio
    .accesskey = K
styleeditor-visibility-toggle-system =
    .tooltiptext = Ne eblas malaktivigi la sistemajn stilfoliojn
styleeditor-save-button = Konservi
