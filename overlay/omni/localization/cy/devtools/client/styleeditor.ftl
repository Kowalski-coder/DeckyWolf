    { $ruleCount ->
        [zero] Dim rheolau.
        [one] { $ruleCount } rheol.
        [two] { $ruleCount } reol.
        [few] { $ruleCount } rheol.
        [many] { $ruleCount } rheol.
       *[other] { $ruleCount } rheol.
    }
