default-browser-agent-task-description = The Default Stravaiger Agent task checks whan the default chynges fae { -brand-short-name } tae anither stravaiger. Gin the chynge taks place unner suspeecious circumstances, it will prompt yaisers tae chynge back tae { -brand-short-name } nae mair nor twa times. This task is instawed automatically by { -brand-short-name }, and is reinstawed whan { -brand-short-name } updates. Tae turn this task aff, update the “default-browser-agent.enabled” preference on the about:config page or the { -brand-short-name } enterprise policy settin “DisableDefaultBrowserAgent”.
default-browser-notification-yes-button-text = Aye
