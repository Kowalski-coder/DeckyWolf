screenshots-instructions = អូស ឬចុចលើទំព័រដើម្បីជ្រើសរើសតំបន់។ ចុច ESC ដើម្បីបោះបង់។
screenshots-cancel-button = បោះបង់
screenshots-meta-key =
    { PLATFORM() ->
        [macos] ⌘
       *[other] Ctrl
    }
screenshots-component-cancel-button =
    .aria-label = បោះបង់
    .title =
        { PLATFORM() ->
            [macos] បោះបង់ (Esc)
           *[other] បោះបង់ (Esc)
        }
