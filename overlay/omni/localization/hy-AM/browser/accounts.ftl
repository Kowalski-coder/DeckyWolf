    { $tabCount ->
        [one] { $tabCount } ներդիրը ստացվել է կապակցված սարքերից:
       *[other] { $tabCount } ներդիրները ստացվել են կապակցված սարքերից:
    }
account-multiple-tabs-arriving-from-unknown-device =
    { $tabCount ->
        [one] { $tabCount } ներդիրը ստացվել է
