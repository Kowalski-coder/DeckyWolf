account-multiple-tabs-arriving-from-single-device =
    { $tabCount ->
        [one] { $tabCount } ներդիր է ստացվել { $deviceName }-ից.
       *[other] { $tabCount } ներդիրներ ստացվել են { $deviceName }-ից:
    }
