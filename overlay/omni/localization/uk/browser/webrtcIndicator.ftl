    .label = Дозволити
    .accesskey = з
webrtc-action-block =
    .label = Блокувати
    .accesskey = Б
webrtc-action-always-block =
    .label = Завжди блокувати
    .accesskey = ж
webrtc-action-not-now =
    .label = Не зараз
    .accesskey = Н
webrtc-remember-allow-checkbox = Запам'ятати це рішення
