webrtc-share-monitor = Екран { $monitorIndex }
webrtc-share-application =
    { $windowCount ->
        [one] { $appName } ({ $windowCount } вікно)
        [few] { $appName } ({ $windowCount } вікна)
       *[many] { $appName } ({ $windowCount } вікон)
    }
