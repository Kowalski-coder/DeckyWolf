styleeditor-new-button =
    .tooltiptext = ایجاد و اضافه کرن یک سبک جدید به سند
    .accesskey = ج
styleeditor-import-button =
    .tooltiptext = اضافه و وارد کردن صفحه تم فعلی به مستندات
    .accesskey = I
styleeditor-filter-input =
    .placeholder = پالایش برگه‌های سبک
styleeditor-visibility-toggle =
    .tooltiptext = تغییر وضعیت نمایش صفحه تم
    .accesskey = ذ
styleeditor-visibility-toggle-system =
    .tooltiptext = برگه‌های سبک سیستمی را نمی‌توان غیرفعال کرد
styleeditor-save-button = ذخیره
    .tooltiptext = ذخیره این صفحه تم در پرونده
    .accesskey = ذ
styleeditor-options-button =
    .tooltiptext = گزینه‌های ویرایشگر سبک
styleeditor-at-rules = قاعده‌های @
styleeditor-no-stylesheet = این صفحه هیچ برگ شیوه‌ای ندارد.
styleeditor-no-stylesheet-tip = شاید شما بخواهید که<a data-l10n-name="append-new-stylesheet">افزودن یک برگ شیوه‌ی جدید</a>؟
styleeditor-open-link-new-tab =
    .label = باز کردن پیوند در زبانهٔ جدید
styleeditor-copy-url =
    .label = کپی نشانی
styleeditor-find =
    .label = پیدا کردن
    .accesskey = پ
styleeditor-find-again =
    .label = پیدا کردن مجدد
    .accesskey = ج
styleeditor-go-to-line =
    .label = برو به خط…
    .accesskey = ب
styleeditor-stylesheet-all-filtered = هیچ برگهٔ سبک منطبقی پیدا نشد.
styleeditor-stylesheet-rule-count =
    { $ruleCount ->
        [one] { $ruleCount } قاعده.
       *[other] { $ruleCount } قاعده.
    }
styleeditor-pretty-print-button =
    .title = چاپ مرتب برگهٔ سبک
styleeditor-pretty-print-button-disabled =
    .title = فقط پرونده‌های CSS را می‌توان مرتب چاپ کرد
styleeditor-pretty-print-button-disabled-read-only =
    .title = برگهٔ سبک فقط‌خواندنی را نمی‌توان مرتب چاپ کرد.
