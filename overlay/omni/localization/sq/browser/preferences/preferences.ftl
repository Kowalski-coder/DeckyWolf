librewolf-webgl-prompt-checkbox2 =
    .label = Fshihi flluskën WebGL të hapura sipas sajtesh
    .description = Kjo bën fshehjen e flluskës që shfaqet kur një sajt provon të krijojë një kontekst WebGL. Mundeni ta hapni prapë dorazi, duke klikuar te ikona në shtyllën e kërkimeve.
librewolf-rfp-checkbox2 =
    .label = Aktivizo ResistFingerprinting
    .description = Aktivizon tërë mbrojtjet kundër krijimi shenjash gishtash, por mund të bëjë që disa sajte të mos funksionojnë si duhet.
librewolf-letterboxing-checkbox2 =
    .label = Aktivizo “letterboxing”
    .description = “Letterboxing” aplikon mënjana përreth dritareve tuaja, që të mund të jepet një grup i kufizuar përfundimesh të rrumbullakosura.
